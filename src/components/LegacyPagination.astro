---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../lib/site';

interface Props { pageNumber: number; }
const { pageNumber } = Astro.props;
const legacy = await getCollection('legacy');
const travel = await getCollection('travel', ({ data }) => !data.draft);
const entries = [
  ...legacy.map((entry) => ({ title: entry.data.title, href: entry.data.legacyPath, date: entry.data.date })),
  ...travel.map((entry) => ({ title: entry.data.title, href: `/travel/${entry.id}/`, date: entry.data.date })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice((pageNumber - 1) * 5, pageNumber * 5);
---

<BaseLayout title={`文章列表 · 第 ${pageNumber} 页`} canonicalPath={`/page${pageNumber}/`}>
  <div class="page-shell">
    <header class="page-header"><div><p class="section-kicker" lang="en">Archive page {pageNumber}</p><h1>继续阅读</h1></div><p>保留原 Jekyll 首页分页 URL，方便旧链接继续访问。</p></header>
    <ul class="archive-list">{entries.map((entry) => <li><time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time><a href={entry.href}>{entry.title}</a></li>)}</ul>
  </div>
</BaseLayout>
