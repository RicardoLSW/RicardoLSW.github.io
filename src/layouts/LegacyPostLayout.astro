---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/site';

interface Props {
  entry: CollectionEntry<'legacy'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath={entry.data.legacyPath} pageType="article">
  <article class="article-shell legacy-article">
    <header class="article-header">
      <p class="eyebrow"><span>{entry.data.categories.join(' · ')}</span><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></p>
      <h1>{entry.data.title}</h1>
      <p class="article-deck">{entry.data.description}</p>
      <ul class="tag-list" aria-label="标签">{entry.data.tags.map((tag) => <li>{tag}</li>)}</ul>
    </header>
    <div class="article-grid">
      <aside class="author-card">
        <img src="/assets/images/bio-photo.jpg" alt="Ricardo 的头像" width="160" height="160" loading="lazy" />
        <strong>Ricardo</strong>
        <p>吾十有五，而志于学</p>
      </aside>
      <div class="prose"><Content /></div>
    </div>
  </article>
</BaseLayout>
