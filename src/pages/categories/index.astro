---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('legacy');
const categories = new Map<string, typeof posts>();
for (const post of posts) for (const category of post.data.categories) categories.set(category, [...(categories.get(category) ?? []), post]);
---

<BaseLayout title="分类" description="按分类浏览旧博客文章。">
  <div class="page-shell">
    <header class="page-header"><div><p class="section-kicker" lang="en">Categories</p><h1>文章分类</h1></div><p>保留原博客的分类入口与文章链接。</p></header>
    {[...categories.entries()].sort(([a], [b]) => a.localeCompare(b, 'zh-CN')).map(([category, entries]) => (
      <section class="archive-year" id={category} aria-labelledby={`category-${category}`}>
        <h2 id={`category-${category}`}>{category}</h2>
        <ul class="archive-list">{entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).map((entry) => <li><time>{entry.data.date.getFullYear()}</time><a href={entry.data.legacyPath}>{entry.data.title}</a></li>)}</ul>
      </section>
    ))}
  </div>
</BaseLayout>
