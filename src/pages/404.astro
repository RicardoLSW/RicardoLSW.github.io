---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面没有找到" description="请求的页面不存在或已经移动。">
  <div class="page-shell">
    <header class="page-header">
      <div><p class="section-kicker" lang="en">404 / Lost</p><h1>走错了一条路。</h1></div>
      <div><p>这个页面不存在，或已经在迁移中改变位置。</p><p><a class="button button-primary" href="/">返回首页</a></p></div>
    </header>
  </div>
</BaseLayout>
