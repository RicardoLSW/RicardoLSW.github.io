---
import { getCollection, type CollectionEntry } from 'astro:content';
import LegacyPostLayout from '../layouts/LegacyPostLayout.astro';
import TravelPostLayout from '../layouts/TravelPostLayout.astro';
import { toPathSegments } from '../lib/site';

export async function getStaticPaths() {
  const legacy = await getCollection('legacy');
  const travel = await getCollection('travel', ({ data }) => !data.draft && Boolean(data.legacyPath));
  return [
    ...legacy.map((entry) => ({ params: { path: toPathSegments(entry.data.legacyPath).join('/') }, props: { legacyEntry: entry } })),
    ...travel.map((entry) => ({ params: { path: toPathSegments(entry.data.legacyPath!).join('/') }, props: { travelEntry: entry } })),
  ];
}

interface Props {
  legacyEntry?: CollectionEntry<'legacy'>;
  travelEntry?: CollectionEntry<'travel'>;
}
const { legacyEntry, travelEntry } = Astro.props;
---

{legacyEntry && <LegacyPostLayout entry={legacyEntry} />}
{travelEntry && <TravelPostLayout entry={travelEntry} canonicalPath={`/travel/${travelEntry.id}/`} />}
