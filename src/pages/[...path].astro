---
import { getCollection, type CollectionEntry } from 'astro:content';
import TravelPostLayout from '../layouts/TravelPostLayout.astro';
import { toPathSegments } from '../lib/site';

export async function getStaticPaths() {
  const travel = await getCollection('travel', ({ data }) => !data.draft && Boolean(data.legacyPath));
  return travel.map((entry) => ({
    params: { path: toPathSegments(entry.data.legacyPath!).join('/') },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'travel'>;
}
const { entry } = Astro.props;
---

<TravelPostLayout entry={entry} canonicalPath={`/travel/${entry.id}/`} />
